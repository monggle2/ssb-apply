    return {...q,on:o.on!==false,q:o.q||q.q,probe:o.probe||q.probe,look:o.look||q.look,anc:o.anc||q.anc,area:o.area||q.area}});
}
function filled(f,v){
  if(f.t==='file')return Array.isArray(v)&&v.length>0;
  if(f.t==='checks')return Array.isArray(v)&&v.length>0;
  if(f.t==='consent')return Array.isArray(v)&&v.length===f.opts.length;
  if(f.t==='scale4')return v&&f.stmts.every((_,i)=>v[i]);
  if(f.t==='rows')return Array.isArray(v)&&v.some(r=>r&&Object.values(r).some(x=>String(x).trim()));
  return v!==undefined&&v!==null&&String(v).trim()!=='';
}
function plain(f,v){
  if(v==null||v==='')return '';
  if(f.t==='number')return Number(v);
  if(f.t==='file')return (v||[]).map(x=>x.name+(x.id?'':' (미저장)')).join(', ');
  if(f.t==='scale4')return f.stmts.map((s,i)=>`${i+1}:${v[i]??''}`).join(' ');
  if(f.t==='rows')return (v||[]).filter(r=>r&&Object.values(r).some(x=>String(x).trim())).map(r=>f.cols.map(c=>r[c.k]??'').join(' ')).join(' / ');
  if(Array.isArray(v))return v.join(', ');
  return String(v);
}
