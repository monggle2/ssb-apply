    if (m) {
      let x = m[1];
      (stops || []).forEach(s => { const i = x.search(new RegExp('[ \\t]' + pxLabel_(s))); if (i >= 0) x = x.slice(0, i); });
      x = x.replace(/\s{2,}.*$/, '').trim();
      if (x) return x;
    }
  }
